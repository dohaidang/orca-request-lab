# @name Health check
# @expect status 200
# @expect header content-type contains application/json
# @timeout 5s
# @retry 2
GET {{baseUrl}}/get?source=request-lab
Accept: application/json

### Create record
# @expect status 200
# @expect json $.json.enabled equals true
# @capture echoedRequestId $.json.requestId
POST {{baseUrl}}/anything
Content-Type: application/json
X-Client: Request-Lab

{
  "name": "Orca",
  "enabled": true,
  "requestId": "{{$randomUUID}}"
}

### Preview image
# @expect status 200
GET {{baseUrl}}/image/png
Accept: image/png
