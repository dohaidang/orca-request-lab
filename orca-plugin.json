{
  "$schema": "https://stably.ai/orca/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "request-lab",
  "name": "Request Lab",
  "version": "0.1.0",
  "description": "Send HTTP requests and inspect responses directly inside Orca.",
  "author": {
    "name": "Đỗ Hải Đăng"
  },
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.255"
  },
  "pluginApi": 1,
  "main": "src/main.ts",
  "contributes": {
    "panels": [
      {
        "id": "request-lab",
        "title": "Request Lab",
        "icon": "globe",
        "entry": "ui/index.html"
      }
    ],
    "customEditors": [
      {
        "id": "request-lab-editor",
        "title": "Request Lab",
        "extensions": [".http", ".rest"],
        "entry": "ui/editor.html",
        "priority": "option",
        "contentKind": "text"
      }
    ]
  }
}
